from __future__ import annotations

from departments.deportes.tenis.service import build_event_cards, build_event_groups


def handle_eventos_tenis(limit: int = 10) -> str:
    groups = build_event_groups(limit=limit)
    if not groups:
        return "🎾 *EVENTOS TENIS*\n\nSin partidos próximos en cache local."

    lines = ["🎾 *EVENTOS TENIS*"]
    for group in groups:
        lines.append("")
        lines.append(f"*{group['day']}*")
        for item in group["items"]:
            line = f"{item['hour']} — {item['title']}"
            if item.get("tour"):
                line += f" [{item['tour']}]"
            if item.get("markets", 0):
                line += f" ({item['markets']} markets)"
            lines.append(line)

    return "\n".join(lines)


def handle_tenis_picks(limit: int = 10) -> str:
    cards = build_event_cards(limit=limit)
    if not cards:
        return "🎾 *TENIS PICKS*\n\nSin picks ni partidos próximos en cache local."

    lines = ["🎾 *TENIS PICKS*", "", "_Base lista; falta capa analítica para picks reales._"]
    for item in cards:
        lines.append(f"{item['index']}. {item['hour']} — {item['title']} [{item['tour']}]")
    return "\n".join(lines)
