async def test_endpoint(session: aiohttp.ClientSession, ep: dict) -> dict:
    headers = ep["headers"].copy()
    headers["X-RapidAPI-Key"] = RAPID_KEY
    
    try:
        async with session.get(ep["url"], headers=headers, timeout=15) as resp:
            return {
                "name": ep["name"],
                "status": resp.status,
                "status_text": "OK" if resp.status == 200 else "FAIL",
                "content_type": resp.headers.get("content-type", "unknown"),
                "content_length": int(resp.headers.get("content-length", 0)),
                "remaining": resp.headers.get("x-ratelimit-remaining-requests"),
                "reset": resp.headers.get("x-ratelimit-reset"),
            }
    except Exception as e:
        return {"name": ep["name"], "status": "ERROR", "error": str(e)[:100]}

async def main():
    async with aiohttp.ClientSession() as session:
        tasks = [test_endpoint(session, ep) for ep in ENDPOINTS]
        results = await asyncio.gather(*tasks)
        
        print("=== RAPIDAPI CATALOGO ===")
        live = []
        for r in results:
            if r.get("status") == 200:
                print(f"✅ {r['name']:20} | {r.get('remaining', 'N/A'):10} | {r.get('content_length', 0):6} bytes")
                live.append(r)
            else:
                print(f"❌ {r['name']:20} | {r.get('status', 'ERROR')}")
        
        print(f"\nLIVE: {len(live)}/{len(ENDPOINTS)}")
        
        # Guardar
        report = {"timestamp": datetime.now().isoformat(), "live": live, "fail": [r for r in results if r.get("status") != 200]}
        Path("rapidapi_catalog.json").write_text(json.dumps(report, indent=2))
        print("Guardado: rapidapi_catalog.json")

if __name__ == "__main__":
    asyncio.run(main())
